---
import RichText from '@lacecms/astro/RichText.astro';
import type { PublishedEntry } from '@lacecms/sdk';
import Layout from '../layouts/Layout.astro';
import { firstYear, getSite, label, projectsInOrder } from '../lace/site';
import '../styles/portfolio-pages.css';

const site = await getSite();
const home = site.byPath('/');
if (!home) throw new Error('Publish Home in Lace Admin before building the site.');

const groups: { year: number; projects: PublishedEntry[] }[] = [];
for (const project of projectsInOrder(site)) {
  const year = firstYear(project.fields.year);
  const group = groups.at(-1);
  if (group?.year === year) {
    group.projects.push(project);
  } else {
    groups.push({ year, projects: [project] });
  }
}
---

<Layout site={site} entry={home}>
  <div class="home-page">
    {home.fields.intro != null && (
      <div class="page-intro">
        <RichText document={home.fields.intro} />
      </div>
    )}
    <section class="portfolio-section" aria-labelledby="projects-heading">
      <h2 class="section-heading" id="projects-heading">{label(home.fields.projectsHeading) ?? 'Selected projects'}</h2>
      {groups.map(({ year, projects }) => (
        <ul class="entry-list project-list" role="list" aria-label={year > 0 ? String(year) : undefined}>
          {projects.map((project) => (
            <li>
              <a class="entry-row" href={project.path}>
                <span class="entry-year">{label(project.fields.year)}</span>
                <span class="entry-primary">{project.title}</span>
                <span class="entry-detail project-summary">{label(project.fields.summary)}</span>
              </a>
            </li>
          ))}
        </ul>
      ))}
    </section>
  </div>
</Layout>
